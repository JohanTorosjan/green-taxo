<div class="analysis-detail-container">
  <!-- Header -->
  <div class="analysis-header">
    <button class="btn btn-back" {{on "click" this.goBack}}>
      ← Retour
    </button>
    
    <div class="header-content">
      <h1>{{@model.name}}</h1>
      <p class="doc-date">
        Analysé le: <strong>{{ @model.created_at}}</strong>
      </p>
    </div>

    <button class="btn btn-download" {{on "click" this.downloadReport}}>
      📥 Télécharger le rapport
    </button>
  </div>

  <!-- Score Card -->
  <div class="score-card {{this.scoreClass}}">
    <div class="score-circle">
      <div class="score-number">{{this.scorePercentage}}</div>
      <div class="score-label">/100</div>
    </div>
    
    <div class="score-details">
      <h2>Score de conformité</h2>
      <p class="score-description">
        {{this.satisfiedCriteriaCount}} critères satisfaits sur {{this.criteriaCount}}
      </p>
      
      <div class="status-badge {{@model.analysis_status}}">
        {{@model.analysis_status}}
      </div>
    </div>
  </div>

  <!-- Stats -->
  <div class="stats-grid">
    <div class="stat-card">
      <div class="stat-value">{{this.criteriaCount}}</div>
      <div class="stat-label">Critères évalués</div>
    </div>
    
    <div class="stat-card">
      <div class="stat-value">{{this.satisfiedCriteriaCount}}</div>
      <div class="stat-label">Critères satisfaits</div>
    </div>
    
    <div class="stat-card">
      <div class="stat-value">
        {{#if @model.score}}
          {{@model.score}}%
        {{else}}
          -
        {{/if}}
      </div>
      <div class="stat-label">Taux de conformité</div>
    </div>
  </div>

  <!-- Criteria List -->
  <div class="criteria-section">
    <h2>Détails des critères</h2>
    
    <div class="criteria-list">
      {{#each this.criteriaList as |criterion|}}
        <div class="criteria-item {{if criterion.present 'satisfied' 'not-satisfied'}}">
          
          <!-- Criteria Header -->
          <div 
            class="criteria-header" 
            {{on "click" (fn this.toggleCriteria criterion.name)}}
            role="button"
            tabindex="0"
          >
            <div class="criteria-status">
              {{#if criterion.present}}
                <span class="badge badge-success">✓ Satisfait</span>
              {{else}}
                <span class="badge badge-danger">✗ Non satisfait</span>
              {{/if}}
            </div>
            
            <div class="criteria-info">
              <h3>{{criterion.name}}</h3>
              <p class="criteria-coefficient">
                Importance: <strong>{{criterion.coefficient}}/5</strong>
              </p>
            </div>
            
            <div class="expand-icon">
              {{#if (this.isCriteriaExpanded criterion.name)}}
                ▼
              {{else}}
                ▶
              {{/if}}
            </div>
          </div>

          <!-- Criteria Details (Expandable) -->
          {{#if (this.isCriteriaExpanded criterion.name)}}
            <div class="criteria-details">
              <div class="description-box">
                <h4>Description</h4>
                <p>{{criterion.description}}</p>
              </div>

              {{#if criterion.justification}}
                <div class="justification-box">
                  <h4>Justification</h4>
                  <blockquote class="quote">
                    {{criterion.justification}}
                  </blockquote>
                </div>
              {{/if}}
            </div>
          {{/if}}
        </div>
      {{/each}}
    </div>
  </div>

  <!-- Metadata -->
  <div class="metadata-section">
    <h3>Informations</h3>
    <table class="metadata-table">
      <tr>
        <td>ID Analyse</td>
        <td><code>{{@model.id}}</code></td>
      </tr>
      <tr>
        <td>Statut</td>
        <td>
          <span class="status-badge {{@model.analysis_status}}">
            {{@model.analysis_status}}
          </span>
        </td>
      </tr>
      <tr>
        <td>Date création</td>
        <td>{{ @model.created_at}}</td>
      </tr>
      <tr>
        <td>Dernière mise à jour</td>
        <td>{{@model.updated_at }}</td>
      </tr>
      {{#if @model.task_id}}
        <tr>
          <td>Task ID Celery</td>
          <td><code>{{@model.task_id}}</code></td>
        </tr>
      {{/if}}
    </table>
  </div>
</div>

