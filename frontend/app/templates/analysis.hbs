<div class="analysis-detail-container">
  {{!-- Header --}}
  <div class="analysis-header">

    <div class="analysis-header-content">
      <h1>{{@model.name}}</h1>
      <p class="doc-date">
        <span class="date-icon"></span>
       Date: <strong>{{this.displayedDate}}</strong>
      </p>
            <p class="doc-date">
        <span class="date-icon"></span>
        Company: <strong>{{@model.company}}</strong>
      </p>
    </div>

      <button type="button" {{on "click" this.openExportModal}} class="btn-export">
     <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/>
              </svg>
    </button>
  </div>

  {{!-- Score Card --}}
  <div class="score-card {{this.scoreClass}}">
    
    {{#if this.isProcessing}}
      {{!-- Spinner for pending/processing --}}
      <div class="spinner-container">
        
        <div class="spinner">
          <div class="spinner-ring"></div>
          <div class="spinner-ring"></div>
          <div class="spinner-ring"></div>
        </div>
        <h2 class="spinner-title">Analysis in Progress</h2>
        <p class="spinner-text">
          {{#if (eq this.analysisStatus "pending")}}
            Your document is queued for analysis...
          {{else}}
            Processing your document...
          {{/if}}
        </p>
        <div class="status-badge {{this.analysisStatus}}">
          <span class="badge-icon">⏳</span>
          {{this.analysisStatus}}
        </div>
      </div>
    {{else}}
      {{!-- Normal score display --}}
      <div class="score-circle">
        <div class="score-number">{{this.scorePercentage}}</div>
        <div class="score-label">/100</div>
        <div class="score-ring"></div>
      </div>
      
      <div class="score-details">
        <h2>Compliance Score</h2>
        <p class="score-description">
          {{this.satisfiedCriteriaCount}} criteria met out of {{this.criteriaCount}}
        </p>
        
        <div class="status-badge {{this.analysisStatus}}">
          <span class="badge-icon">✓</span>
          {{this.analysisStatus}}
        </div>
      </div>
    {{/if}}

  </div>

  {{!-- Stats --}}
  <div class="stats-grid">
    <div class="stat-card">
      <div class="stat-content">
        <div class="stat-value">{{this.criteriaCount}}</div>
        <div class="stat-label">Criteria Evaluated</div>
      </div>
    </div>
    
    <div class="stat-card">
      <div class="stat-content">
        <div class="stat-value">{{this.satisfiedCriteriaCount}}</div>
        <div class="stat-label">Criteria Met</div>
      </div>
    </div>
    
    <div class="stat-card">
      <div class="stat-content">
        <div class="stat-value">
          {{#if this.analysisScore}}
            {{this.analysisScore}}%
          {{else}}
            -
          {{/if}}
        </div>
        <div class="stat-label">Compliance Rate</div>
      </div>
    </div>
  </div>

  {{!-- Criteria List --}}
  <div class="criteria-section">
    <h2>Criteria Details</h2>
    
    <div class="criteria-list">
      {{#each this.criteriaList as |criterion|}}

        <div class="criteria-item {{if criterion.present 'satisfied' 'not-satisfied'}}">
          
          {{!-- Criteria Header --}}
          <div 
            class="criteria-header" 
            {{on "click" (fn this.toggleCriteria criterion.name)}}
            role="button"
            tabindex="0"
          >
            <div class="criteria-status">
              {{#if criterion.present}}
                <span class="badge badge-success">
                  <span class="badge-icon">✓</span>
                  <span>Met</span>
                </span>
              {{else}}
                <span class="badge badge-danger">
                  <span class="badge-icon">✗</span>
                  <span>Not Met</span>
                </span>
              {{/if}}
            </div>
            
            <div class="criteria-info">
              <h3>{{criterion.name}}</h3>
              <p class="criteria-coefficient">
                <span class="importance-dots">
                  {{#each criterion.coefficient as |dot|}}
                    <span class="dot active"></span>
                  {{/each}}
                  {{#each criterion.coefficient as |dot|}}
                    <span class="dot"></span>
                  {{/each}}
                </span>
                <span class="importance-label">Importance: {{criterion.coefficient}}/5</span>
              </p>
            </div>
            
            <div class="expand-icon">
              {{#if (this.isCriteriaExpanded criterion.name)}}
                <span class="chevron down">▼</span>
              {{else}}
                <span class="chevron right">▶</span>
              {{/if}}
            </div>
          </div>

          {{!-- Criteria Details (Expandable) --}}
          {{#if (this.isCriteriaExpanded criterion.name)}}
            <div class="criteria-details">
              <div class="description-box">
                <h4>📋 Description</h4>
                <p>{{criterion.description}}</p>
              </div>

              {{#if criterion.justification}}
                <div class="justification-box">
                  <h4>💡 Justification</h4>
                  <blockquote class="quote">
                    {{criterion.justification}}
                  </blockquote>
                </div>
              {{/if}}
            </div>
          {{/if}}
        </div>
      {{/each}}
    </div>
  </div>
  {{!-- Metadata --}}
  {{#if this.auth.currentUser.admin}}
  <div class="metadata-section">
    <h3>ℹ️ Information</h3>
    <div class="metadata-grid">
      <div class="metadata-item">
        <span class="metadata-label">Analysis ID</span>
        <code class="metadata-value">{{@model.id}}</code>
      </div>
      
      <div class="metadata-item">
        <span class="metadata-label">Status</span>
        <span class="status-badge {{this.analysisStatus}}">
          <span class="badge-icon">✓</span>
          {{this.analysisStatus}}
        </span>
      </div>
      
      <div class="metadata-item">
        <span class="metadata-label">Created Date</span>
        <span class="metadata-value">{{@model.created_at}}</span>
      </div>
      <div class="metadata-item">
        <span class="metadata-label">User ID</span>
        <span class="metadata-value">{{@model.user_id}}</span>  
      </div>
      
      <div class="metadata-item">
        <span class="metadata-label">Last Updated</span>
        <span class="metadata-value">{{@model.updated_at}}</span>
      </div>
      
      {{#if @model.task_id}}
        <div class="metadata-item">
          <span class="metadata-label">Celery Task ID</span>
          <code class="metadata-value">{{@model.task_id}}</code>
        </div>
      {{/if}}
    </div>
  </div>
  {{/if}}
    {{! Export modal }}
  {{#if this.showExportModal}}
    <ExportModal 
      @selectedCount="1"
      @onClose={{this.closeExportModal}}
      @onConfirm={{this.handleExportConfirm}}
    />
  {{/if}}
</div>

