<div class="criterias-container">
  <div class="criterias-header">
    <div class="criterias-header-content">
      <h1>Criteria Management</h1>
      <p class="header-subtitle">Manage and organize your evaluation criteria</p>
    </div>
            <div class="create-criteria-butt">
                  <button class="btn btn-primary" type="button" {{on "click" this.openCreateModal}}>
    + Add Criterion
    </button>
            </div>


  </div>

  {{#if this.isLoading}}
    <div class="loading-spinner">
      <div class="spinner"></div>
      <p>Loading criteria...</p>
    </div>
  {{else}}
    {{#if this.criterias.length}}
      <div class="criterias-grid">
        {{#each this.criterias as |criteria|}}
          <div class="criteria-card">
            <div class="card-header">
              <h3>{{criteria.nom}}</h3>
              <div class="card-actions">
                <button class="btn btn-sm btn-edit" type="button" {{on "click" (fn this.openEditModal criteria)}} title="Edit criterion">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                          d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5M18.5 2.5a2.121 2.121 0 013 3L12 15l-4 1 1-4 9.5-9.5z"/>
                  </svg>
                </button>
                <button class="btn btn-sm btn-delete" type="button" {{on "click" (fn this.deleteCriteria criteria.id)}} title="Delete criterion">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
                  </svg>
                </button>
              </div>
            </div>
            <div class="card-body">
              <p class="description">{{criteria.description}}</p>
              <div class="criteria-details">
                <span class="detail-badge coefficient">
                  <span class="badge-label">Coefficient</span>
                  <strong>{{criteria.coefficient}}</strong>
                </span>
                {{!-- <span class="detail-badge id">
                  <span class="badge-label">ID</span>
                  <strong>{{criteria.id}}</strong>
                </span> --}}
              </div>
              {{#if criteria.data}}
                <div class="criteria-data">
                  <p class="data-label">Additional Data</p>
                  <pre>{{this.stringifyData criteria.data}}</pre>
                </div>
              {{/if}}
            </div>
          </div>
        {{/each}}
      </div>
    {{else}}
      <div class="empty-state">
        <h3>No criteria found</h3>
        <p>Get started by creating your first evaluation criterion</p>
        {{!-- <button class="btn btn-primary" type="button" {{on "click" this.openCreateModal}}>
          Create First Criterion
        </button> --}}
      </div>
    {{/if}}
  {{/if}}

  {{#if this.showModal}}
    <div class="modal-overlay" {{on "click" this.closeModal}}>
      <div class="modal" {{on "click" this.stopPropagation}}>
        <div class="modal-header">
          <h2>{{if this.isEditMode "Edit" "Create"}} Criterion</h2>
          <button class="btn-close" type="button" {{on "click" this.closeModal}}>✕</button>
        </div>

        <form class="modal-form" {{on "submit" this.saveCriteria}}>
          <div class="form-group">
            <label for="nom">Name <span class="required">*</span></label>
            <input
              type="text"
              id="nom"
              class="form-control"
              value={{this.formData.nom}}
              {{on "input" (fn this.updateFormData "nom")}}
              placeholder="Enter criterion name"
              required
            />
          </div>

          <div class="form-group">
            <label for="description">Description <span class="required">*</span> </label>
            <textarea
              id="description"
              class="form-control"
              value={{this.formData.description}}
              {{on "input" (fn this.updateFormData "description")}}
              rows="4"
              placeholder="Describe the evaluation criterion"
            ></textarea>
          </div>

          <div class="form-group">
            <label for="coefficient">Coefficient <span class="required">*</span></label>
            <input
              type="number"
              id="coefficient"
              class="form-control"
              value={{this.formData.coefficient}}
              {{on "input" (fn this.updateFormData "coefficient")}}
              placeholder="e.g., 1.5"
              required
            />
          </div>

          <div class="modal-footer">
            <button type="button" class="btn btn-secondary" {{on "click" this.closeModal}}>
              Cancel
            </button>
            <button type="submit" class="btn btn-primary">
              {{if this.isEditMode "Update" "Create"}}
            </button>
          </div>
        </form>
      </div>
    </div>
  {{/if}}

  {{#if this.successMessage}}
    <div class="alert alert-success">
      <span class="alert-icon">✓</span>
      {{this.successMessage}}
    </div>
  {{/if}}

  {{#if this.errorMessage}}
    <div class="alert alert-error">
      <span class="alert-icon">⚠</span>
      {{this.errorMessage}}
    </div>
  {{/if}}
</div>