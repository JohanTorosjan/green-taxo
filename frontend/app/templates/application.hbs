{{page-title "Green-Taxo"}}

<div class="app-container">
  <header class="app-header">
    <div class="header-content">
      <div class="header-left">
        <h1 class="app-logo">Green-Taxo</h1>
        <nav class="main-nav">
          {{this.auth.currentUser}}
          <LinkTo @route="analyse" class="nav-link">Analyze a report </LinkTo>
          <LinkTo @route="admin" class="nav-link">Admin</LinkTo>
        </nav>
      </div>
      <div class="header-right">
        <button type="button" class="btn-icon" aria-label="Notifications">
          <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"/>
          </svg>
        </button>
        <button type="button" class="btn-icon" aria-label="Profil">
          <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
          </svg>
        </button>
      </div>
    </div>
  </header>

  <main class="app-main">
    <div class="main-content">
      {{outlet}}
    </div>
  </main>

  <footer class="app-footer">
    <div class="footer-content">
      <div class="footer-left">
        <p>&copy; By Chaire SCORE.</p>
      </div>
      <div class="footer-right">
        <a href="#" class="footer-link">À propos</a>
        <a href="#" class="footer-link">Confidentialité</a>
        <a href="#" class="footer-link">Conditions</a>
        <a href="#" class="footer-link">Support</a>
      </div>
    </div>
  </footer>
</div>