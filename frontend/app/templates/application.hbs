{{page-title "Green-Taxo"}}

<div class="app-container">
  <header class="app-header">
    <div class="header-content">
      <div class="header-left">
        <h1 class="app-logo">Green-Taxo</h1>
        <nav class="main-nav">
        
          <LinkTo @route="analyse" class="nav-link">Analyze a report </LinkTo>
      {{#if this.auth.currentUser.admin}}
          <LinkTo @route="admin" class="nav-link">Admin</LinkTo>
          {{/if}}
        </nav>
      </div>
      <div class="header-right">
              {{#if this.auth.isAuthenticated}}
<button type="button" class="btn-icon" aria-label="Déconnexion" {{on "click" this.logout}}>
  <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/>
  </svg>
</button>          {{/if}}

      </div>
    </div>
  </header>

  <main class="app-main">
    <div class="main-content">
      {{outlet}}
    </div>
  </main>

  <footer class="app-footer">
    <div class="footer-content">
      <div class="footer-left">
        <p>By Chaire SCORE.</p>
      </div>
      <div class="footer-right">
        <a href="#" class="footer-link">About</a>
        {{!-- <a href="#" class="footer-link">Confidentialité</a>
        <a href="#" class="footer-link">Conditions</a>
        <a href="#" class="footer-link">Support</a> --}}
      </div>
    </div>
  </footer>
</div>