{{! frontend/app/components/export-modal.hbs }}
<div class="modal-overlay" {{on "click" this.closeModal}}>
  <div class="modal-content" {{on "click" this.stopPropagation}} role="dialog" aria-modal="true">
    <div class="modal-header">
      <h2>Export Options</h2>
      <button type="button" class="modal-close" {{on "click" this.closeModal}} aria-label="Close">
        ×
      </button>
    </div>

    <div class="modal-body">
      <p class="modal-description">
        Select columns to include in your export ({{@selectedCount}} analysis(es) selected)
      </p>

      {{! Quick actions }}
      {{!-- <div class="quick-actions">
        <button type="button" class="btn-secondary" {{on "click" this.selectAll}}>
          Select All
        </button>
        <button type="button" class="btn-secondary" {{on "click" this.deselectAll}}>
          Deselect All
        </button>
      </div> --}}

      {{! Base columns (checked by default) }}
      <div class="export-section">
        <h3>Main Columns</h3>
        <div class="checkbox-group">
          <label class="checkbox-label">
            <input 
              type="checkbox" 
                disabled="true"

              checked={{this.includeId}}
              {{on "change" (fn this.toggleColumn "includeId")}}
            />
            <span>ID</span>
          </label>

          <label class="checkbox-label">
            <input 
              type="checkbox" 
              checked={{this.includeName}}
              disabled="true"
              {{on "change" (fn this.toggleColumn "includeName")}}
            />
            <span>Name</span>
          </label>

          <label class="checkbox-label">
            <input 
              type="checkbox" 
              checked={{this.includeCreatedAt}}
              {{on "change" (fn this.toggleColumn "includeCreatedAt")}}
            />
            <span>Creation Date</span>
          </label>

          <label class="checkbox-label">
            <input 
              type="checkbox" 
              checked={{this.includeDocDate}}
              {{on "change" (fn this.toggleColumn "includeDocDate")}}
            />
            <span>Document Date</span>
          </label>

          <label class="checkbox-label">
            <input 
              type="checkbox" 
              checked={{this.includeUserEmail}}
              {{on "change" (fn this.toggleColumn "includeUserEmail")}}
            />
            <span>User Email</span>
          </label>


          <label class="checkbox-label">
            <input 
              type="checkbox" 
              checked={{this.includeCompany}}
              {{on "change" (fn this.toggleColumn "includeCompany")}}
            />
            <span>Company</span>
          </label>


          <label class="checkbox-label">
            <input 
              type="checkbox" 
              checked={{this.includeScore}}
              {{on "change" (fn this.toggleColumn "includeScore")}}
            />
            <span>Score</span>
          </label>
        </div>
      </div>

      {{! JSON columns (not checked by default) }}
      <div class="export-section">
        <h3>JSON Data</h3>
        <div class="checkbox-group">
          <label class="checkbox-label">
            <input 
              type="checkbox" 
              checked={{this.includeFullResults}}
              {{on "change" (fn this.toggleColumn "includeFullResults")}}
            />
            <span>Full Results (JSON)</span>
          </label>

          <label class="checkbox-label">
            <input 
              type="checkbox" 
              checked={{this.includeCalculationModel}}
              {{on "change" (fn this.toggleColumn "includeCalculationModel")}}
            />
            <span>Calculation Model (JSON)</span>
          </label>
        </div>
      </div>

      {{! Separate files }}
      <div class="export-section export-section-separated">
        <h3>Separate Files</h3>
        <p class="section-note">These options will create individual files for each analysis</p>
        <div class="checkbox-group">
          <label class="checkbox-label">
            <input 
              type="checkbox" 
              checked={{this.exportResultsFiles}}
              {{on "change" (fn this.toggleColumn "exportResultsFiles")}}
            />
            <span>Results (one file per analysis)</span>
          </label>

          <label class="checkbox-label">
            <input 
              type="checkbox" 
              checked={{this.exportCalculationFiles}}
              {{on "change" (fn this.toggleColumn "exportCalculationFiles")}}
            />
            <span>Calculation Model (one file per analysis)</span>
          </label>

          <label class="checkbox-label">
            <input 
              type="checkbox" 
              checked={{this.exportJustificationFile}}
              {{on "change" (fn this.toggleColumn "exportJustificationFile")}}
            />
            <span>Selection Justification (separate file)</span>
          </label>
        </div>

        {{#if this.hasAnySeparateFileSelected}}
          <div class="warning-note">
            <strong>Note:</strong> The export will generate multiple files in a ZIP archive
          </div>
        {{/if}}
      </div>
    </div>

    <div class="modal-footer">
      <button type="button" class="btn-cancel" {{on "click" this.closeModal}}>
        Cancel
      </button>
      <button type="button" class="btn-confirm" {{on "click" this.confirmExport}}>
        Export
      </button>
    </div>
  </div>
</div>